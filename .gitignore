# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE and editor state
.idea/
.vscode/

# OS metadata
.DS_Store
__MACOSX/
Thumbs.db

# Logs
*.log

# Local virtual environments
.venv/
venv/
env/

# Internal working directory used while assembling this artifact
.audit_tmp/

# Output of re-runs and of figure regeneration. The scripts default here so that
# nothing ever overwrites the archived data/ or figures/ trees.
output/

# Note: CSV, JSON, PDF, EPS and PNG files under data/ and figures/ are part of
# the published artifact and are intentionally NOT ignored.
